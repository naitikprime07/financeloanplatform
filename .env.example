# ============================================================
# FINVEXA ADVERTISING CONFIGURATION
# ============================================================
# Public browser identifiers only. Never place API secrets here.
# AdSense publisher/client format: ca-pub-1234567890123456
VITE_ADSENSE_PUBLISHER_ID=

# Responsive content placements shared by home, category, and blog pages.
# Values are AdSense numeric ad-slot IDs, for example: 1234567890
VITE_AD_SLOT_CONTENT_TOP=
VITE_AD_SLOT_CONTENT_MIDDLE_1=
VITE_AD_SLOT_CONTENT_MIDDLE_2=
VITE_AD_SLOT_CONTENT_MIDDLE_3=
VITE_AD_SLOT_CONTENT_BOTTOM=

# Fixed mobile bottom/anchor placement.
VITE_AD_SLOT_MOBILE_ANCHOR=

# Optional fluid/native in-content unit. When configured, Middle 3 uses it.
VITE_AD_SLOT_NATIVE_IN_CONTENT=

# Optional wide-desktop side rails. Displayed only at 1536px and wider.
VITE_AD_SLOT_DESKTOP_SIDE_LEFT=
VITE_AD_SLOT_DESKTOP_SIDE_RIGHT=

# Optional out-of-page unit identifiers retained for future provider setup.
# These are not displayed unless a compatible provider integration is enabled.
VITE_AD_SLOT_INTERSTITIAL=
VITE_AD_SLOT_REWARDED=

# ============================================================
# BLOG DETAIL TRACKING
# ============================================================
# Custom event fired only after a valid /blog/:slug page opens.
# Keep blog_view unless your analytics naming convention requires another name.
VITE_BLOG_VIEW_EVENT_NAME=blog_view

# Optional 1x1 tracking-pixel URL. Leave empty when using only dataLayer/gtag/fbq.
# The pixel fires once per completed blog-detail navigation, including direct refresh.
# Supported placeholders are URL encoded automatically:
#   {event} or {event_name} - custom event name
#   {path}                  - /blog/example-slug
#   {url}                   - complete page URL
#   {title}                 - blog title
#   {slug}                  - blog slug/ID
#   {category}              - blog category
# Example:
# VITE_BLOG_VIEW_PIXEL_URL=https://tracker.example/pixel.gif?event={event}&slug={slug}&url={url}
VITE_BLOG_VIEW_PIXEL_URL=

# Optional browser logging for tracking-event troubleshooting.
VITE_TRACKING_DEBUG=false