VITE_ENGLISH_DOMAIN=https://financeloanplatform.com
VITE_HINDI_DOMAIN=https://hi.financeloanplatform.com
VITE_DEFAULT_LANGUAGE=en

# Environment entries override the centralized production defaults.
# "blog" scopes a host to an existing category/pixel content key.
# "primaryCategory" only controls ordering and remains backward compatible.
# VITE_DOMAIN_CONFIG={"financeloanplatform.com":{"language":"en","blog":null},"hi.financeloanplatform.com":{"language":"hi","blog":null},"personal_en.financeloanplatform.com":{"language":"en","blog":"personal-loan"},"personalloan_hi.financeloanplatform.com":{"language":"hi","blog":"personal-loan"}}

